#!/bin/sh
#
# PX4 startup script for STM32N6 NUCLEO - HIL Quadcopter
# Matches Pixhawk 6C (fmu-v6c) airframe 1001 configuration
#
set +e

param import

# HIL mode - quadrotor
param set SYS_HITL 1
param set SYS_AUTOSTART 1001
param set MAV_TYPE 2

# rc.mc_defaults (normally sourced by airframe init)
param set IMU_GYRO_RATEMAX 800
param set NAV_ACC_RAD 2
param set RTL_RETURN_ALT 30
param set RTL_DESCEND_ALT 10
param set EKF2_RNG_FOG 1

# Quad rotor geometry — matches 1001_rc_quad_x.hil exactly
param set CA_AIRFRAME 0
param set CA_ROTOR_COUNT 4
param set CA_ROTOR0_PX 1
param set CA_ROTOR0_PY 1
param set CA_ROTOR1_PX -1
param set CA_ROTOR1_PY -1
param set CA_ROTOR2_PX 1
param set CA_ROTOR2_PY -1
param set CA_ROTOR2_KM -0.05
param set CA_ROTOR3_PX -1
param set CA_ROTOR3_PY 1
param set CA_ROTOR3_KM -0.05
param set HIL_ACT_FUNC1 101
param set HIL_ACT_FUNC2 102
param set HIL_ACT_FUNC3 103
param set HIL_ACT_FUNC4 104

# fmu-v6c board defaults
param set BAT1_V_DIV 18.1
param set BAT2_V_DIV 18.1
param set BAT1_A_PER_V 36.367515152
param set BAT2_A_PER_V 36.367515152

# Disable checks (no SD card, no barometer on Nucleo)
param set COM_ARM_SDCARD 0
param set SYS_HAS_BARO 0
param set CBRK_SUPPLY_CHK 894281
param set UAVCAN_ENABLE 0

# Start everything. Sensors module retries VehicleIMU init every 500ms
# until jMAVSim provides HIL_SENSOR data. No sleeps needed.
dataman start -r
load_mon start
sensors start -h
ekf2 start &
commander start -h
pwm_out_sim start -m hil
control_allocator start
mc_rate_control start
mc_att_control start
mc_hover_thrust_estimator start
flight_mode_manager start
mc_pos_control start
land_detector start multicopter
navigator start
npu
npu duty 0
mavlink start -d /dev/ttyACM0 -b 921600 -r 20000 &
mavlink boot_complete
sleep 1
mavlink stream -d /dev/ttyACM0 -s NPU_STATUS -r 10
